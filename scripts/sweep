#!/usr/bin/env bash
# 여러 지구를 순차로 수집하고 하나로 합친다.
#
# 넓은 도시는 한 번에 훑으면 안 된다 - 구글이 넓은 뷰포트에서는 같은 곳만
# 돌려준다(실측: 런던 반경 10km 한 번 = 120곳, 8개 지구로 나누니 667곳).
# 동시에 돌리지 않는다. 브라우저가 하나뿐이고 동시 접속은 차단 위험을 키운다.
#
# 사용:
#   scripts/sweep <지구목록파일> <키워드접두> <지역코드> <도시이름>
#
# 결과는 out/<도시이름>/ 아래에 지구별 파일과 ALL.xlsx로 나온다.
#
# 지구목록 파일 형식 (# 로 시작하는 줄은 주석):
#   이름|위도,경도|반경km|셀km
#   Harley-Street|51.5205,-0.1490|2|1.5
set -euo pipefail

LIST=${1:?지구목록 파일이 필요합니다}
KEYWORD=${2:?키워드 접두가 필요합니다}
REGION=${3:?지역코드가 필요합니다}
PREFIX=${4:?출력 접두가 필요합니다}
LANG_CODE=${5:-en}

cd "$(dirname "$0")/.."
DIR="out/${PREFIX}"
LOG="${DIR}/_sweep.log"
mkdir -p "$DIR"

while IFS='|' read -r name center radius cell; do
  [[ -z "${name:-}" || "$name" == \#* ]] && continue
  out="${DIR}/${name}.csv"
  if [ -f "$out" ]; then
    echo "$(date +%H:%M) $name 이미 있음, 건너뜀" | tee -a "$LOG"
    continue
  fi
  echo "$(date +%H:%M) === $name 시작 (반경 ${radius}km, 셀 ${cell}km) ===" | tee -a "$LOG"
  uv run sourcing "$KEYWORD ${name//-/ }" \
    --region "$REGION" --lang "$LANG_CODE" \
    --center="$center" --radius-km "$radius" --cell-km "$cell" \
    --out "$out" >> "$LOG" 2>&1 || echo "  ! $name 실패, 계속" | tee -a "$LOG"
  echo "$(date +%H:%M) === $name 완료 ===" | tee -a "$LOG"
done < "$LIST"

echo "$(date +%H:%M) 전체 수집 완료. 합치는 중..." | tee -a "$LOG"
uv run sourcing-merge "$DIR"/*.raw.jsonl --out "${DIR}/ALL.xlsx" | tee -a "$LOG"
